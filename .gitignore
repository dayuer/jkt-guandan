# 前端依赖与构建产物。dist 里留一个 .gitkeep，Go 的 embed 需要这个目录存在。
node_modules/
app/h5/dist/*
!app/h5/dist/.gitkeep

# 二进制与本地数据
/bin/
/.data/
/data/
*.db
*.db-wal
*.db-shm

.DS_Store
*.log
.claude/worktrees/

# Playwright 端到端测试的产物（#72）
app/h5/test-results/
app/h5/playwright-report/

# go build ./server/cmd/... 在仓库根目录留下的二进制
/guandan

# 小游戏：开发者工具的个人配置和预览二维码
app/minigame/project.private.config.json
